 &time_control
 run_days                            = 0,
 run_hours                           = 0,
 run_minutes                         = 0,
 run_seconds                         = 0,
 start_year                          = 2023,
 start_month                         = 07, 
 start_day                           = 21,  
 start_hour                          = 00, 
 end_year                            = 2023, 
 end_month                           = 08, 
 end_day                             = 01,  
 end_hour                            = 00,  
 interval_seconds                    = 21600
 input_from_file                     = .true.,
 history_interval                    = 60, 
 frames_per_outfile                  = 24,  
 restart                             = .false.,
 restart_interval                    = 72000,
 force_use_old_data                  = .true.
 io_form_history                     = 2
 io_form_restart                     = 2
 io_form_input                       = 2
 io_form_boundary                    = 2
 io_form_auxinput8                   = 2,                      
 auxinput8_inname                    = "trmask_d01",    
 debug_level                         = 0
 /

 &domains
 time_step                           = 40,
 time_step_fract_num                 = 0,
 time_step_fract_den                 = 1,
 max_dom                             = 1,
 e_we                                = 1100,  
 e_sn                                = 700,  
 e_vert                              = 45,   
 dzstretch_s                         = 1.1
 p_top_requested                     = 5000,
 num_metgrid_levels                  = 38,
 num_metgrid_soil_levels             = 4,
 dx                                  = 10000, 
 dy                                  = 10000, 
 grid_id                             = 1,    
 parent_id                           = 0,   
 i_parent_start                      = 1,   
 j_parent_start                      = 1,    
 parent_grid_ratio                   = 1,    
 parent_time_step_ratio              = 1,     
 feedback                            = 0,
 smooth_option                       = 0
 /

 &physics
 physics_suite                       = 'CONUS'
 mp_physics                          =  6,     
 cu_physics                          =  1,    
 ra_lw_physics                       = -1,    
 ra_sw_physics                       = -1,    
 bl_pbl_physics                      = 1,     
 sf_sfclay_physics                   = 1,    
 sf_surface_physics                  = -1,  
 radt                                = 7.5, 
 bldt                                = 0,   
 cudt                                = 0,   
 icloud                              = 1,
 num_land_cat                        = 21,
 sf_urban_physics                    = 0,   
 fractional_seaice                   = 1,
 scalar_pblmix                       = 0,
 tracer_pblmix                       = 0,
 /

 &fdda
 grid_fdda                       = 2
 gfdda_inname                    = "wrffdda_d<domain>"
 gfdda_interval_m                = 360   
 gfdda_end_h                     = 999999
 io_form_gfdda                   = 2
 fgdt                            = 0
 grid_sfdda                      = 0    
 if_no_pbl_nudging_uv            = 1        ! 1= no nudging of u and v in the pbl, 0=nudging in the pbl
 if_zfac_uv                      = 1,       ! 0= nudge uv in all layers, 1= limit nudging to levels above k_zfac_uv
  k_zfac_uv                      = 10,      ! 0= model level below which nudging is switched off for uv
 if_no_pbl_nudging_t             = 1        ! 1= no nudging of temp in the pbl, 0=nudging in the pbl
 if_zfac_t                       = 1,       ! 0= nudge t in all layers, 1= limit nudging to levels above k_zfac_t
  k_zfac_t                       = 10,      ! 0= model level below which nudging is switched off for t
 if_no_pbl_nudging_q             = 1        ! 1= no nudging of qvapor in the pbl, 0=nudging in the pbl
 if_zfac_q                       = 1,       ! 0= nudge q in all layers, 1= limit nudging to levels above k_zfac_q
  k_zfac_q                       = 10,      ! 0= model level below which nudging is switched off for q
 guv                             = 0.0003  
 gt                              = 0.0003  
 gq                              = 0.00001 
 if_ramping                      = 0
 dtramp_min                      = 0    
 /

 &dynamics
 hybrid_opt                          = 2, 
 w_damping                           = 0,
 diff_opt                            = 2,    
 km_opt                              = 4,    
 diff_6th_opt                        = 0,   
 diff_6th_factor                     = 0.12,  
 base_temp                           = 290.
 damp_opt                            = 3,
 zdamp                               = 5000.,  
 dampcoef                            = 0.2,  
 khdif                               = 0,    
 kvdif                               = 0,    
 non_hydrostatic                     = .true.,
 moist_adv_opt                       = 1,     
 scalar_adv_opt                      = 1,     
 gwd_opt                             = 1,     
 tracer_adv_opt                      = 4,	   
 tracer_opt                          = 4,	  
 tracer2dsource                      = 0,	
 tracer3dsource                      = 1,
 tracer3dsink                        = 0,
 /

 &bdy_control
 spec_bdy_width                      = 10,
 spec_zone                           = 1,
 relax_zone                          = 9,
 specified                           = .true.,
 nested                              = .false.,
 /

 &namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1,
 /
